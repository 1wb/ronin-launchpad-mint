# ===== Yakkamon mint 配置模板 =====
# 复制为 .env 后填写。真实环境变量 > .env > 脚本默认值。
# .env 含明文私钥:不要提交到 git、不要上传网盘/聊天工具。

# 钱包私钥(必须是白名单地址的私钥)。留空则只能 dry-run。
MINT_PK=

# RPC 端点,逗号分隔:启动时自动测速选最快做轮询,开火时向所有存活端点并行广播。
# 免费可用(2026-09-17 实测):
#   https://ronin.drpc.org                 dRPC 公共,~257ms
#   https://api.roninchain.com/rpc         Sky Mavis 官方公共,~966ms,限频 30/s、100/min
# 带 key 更快/更高限额(各自平台注册):
#   https://lb.drpc.live/ronin/<你的 dRPC key>
#   https://api-gateway.skymavis.com/rpc   (developers.skymavis.com 免费 key)
#   https://ronin-mainnet.g.alchemy.com/v2/<key>  (app 里需启用 Ronin 网络)
# MINT_RPC=https://ronin.drpc.org,https://api.roninchain.com/rpc

# ---- 以下可选,不填用默认值 ----

# 目标阶段(4=Yakkamon Hunters, 5=Public Trainers)
# STAGE=4

# 本次 mint 数量
# QTY=1

# 模拟轮询间隔(毫秒)
# POLL=800

# 交易 gasLimit(实测 mint 约 27~29 万,默认 35 万留余量;它同时决定余额担保 gasLimit×maxFee)
# GAS=350000

# 优先费 tip(gwei),真实插队杠杆;0=跟随 RPC 建议
# GAS_TIP_GWEI=0

# 自动模式:tip = 最近 5 块优先费的中位数 × 该倍数
# GAS_TIP_BOOST=2

# 自动模式:tip 硬上限 = 下一块 baseFee × 该倍数(防止单块天价小费带偏)
# GAS_TIP_CAP=5

# maxFeePerGas = 估算值 × 百分比
# GAS_BUMP_PCT=150
